{
  "name": "@spindle-studio/n8n-nodes-matrix-e2ee",
  "version": "0.1.0",
  "description": "n8n nodes for sending and receiving Matrix E2EE gateway messages",
  "license": "MIT",
  "homepage": "https://github.com/spindle-studio/n8n-matrix-e2ee",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "Ben Murray",
    "email": "ben@spindle.studio"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/spindle-studio/n8n-matrix-e2ee.git",
    "directory": "nodes"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "node --test tests/*.test.cjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/MatrixE2eeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/MatrixE2ee/MatrixE2eeAction.node.js",
      "dist/nodes/MatrixE2ee/MatrixE2eeTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^22.20.5",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=22.4.0"
  }
}
